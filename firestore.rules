rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function autorizadoPath(uid) {
      return /databases/$(database)/documents/autorizados/$(uid);
    }

    function authDocExists() {
      return isSignedIn() && exists(autorizadoPath(request.auth.uid));
    }

    function authData() {
      return get(autorizadoPath(request.auth.uid)).data;
    }

    function currentTenantId() {
      return authDocExists()
        ? (
            authData().negocioId is string && authData().negocioId != ""
              ? authData().negocioId
              : (
                  authData().cuentaPrincipalUid is string &&
                  authData().cuentaPrincipalUid != ""
                    ? authData().cuentaPrincipalUid
                    : request.auth.uid
                )
          )
        : request.auth.uid;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'lechugapapayero@gmail.com';
    }

    function hasAnalyticsAccess() {
      return isSuperAdmin();
    }

    function isBusinessAdmin() {
      return authDocExists() && (
        authData().rol == "Administrador" ||
        authData().rol == "administrador"
      );
    }

    function hasPermission(key) {
      return isBusinessAdmin() || (
        authDocExists() &&
        authData().permisos is map &&
        authData().permisos[key] == true
      );
    }

    function canUseOperationalCollection(name) {
      return isBusinessAdmin() ||
        (name == 'productos' && (hasPermission('productos.ver') || hasPermission('ventas.pos'))) ||
        (name == 'clientes' && (hasPermission('clientes.ver') || hasPermission('ventas.pos'))) ||
        (name == 'fiados' && (hasPermission('clientes.ver') || hasPermission('ventas.pos'))) ||
        (name in ['ventas', 'cotizaciones', 'cortes_caja', 'egresos_diarios'] &&
          (hasPermission('ventas.pos') || hasPermission('reportes.ver'))) ||
        (name == 'promociones_descuentos' &&
          (hasPermission('promociones.gestionar') || hasPermission('descuentos.gestionar'))) ||
        (name == 'proveedores' &&
          (hasPermission('productos.ver') || hasPermission('configuracion.ver'))) ||
        (name == 'servicios' &&
          (hasPermission('servicios.ver') || hasPermission('servicios.crear'))) ||
        (name == 'empleados' && hasPermission('empleados.gestionar')) ||
        (name == 'configuracion' && hasPermission('configuracion.ver')) ||
        (name in ['restaurante_ordenes', 'restaurante_reservaciones', 'restaurante_turnos'] &&
          (hasPermission('restaurante.caja') ||
           hasPermission('restaurante.cocina') ||
           hasPermission('restaurante.mesero'))) ||
        name in [
          'pos_mobile_scans', 'terminos_aceptaciones',
          'recomendaciones', 'folios', 'contadores_folio'
        ];
    }

    function negocioTienePremiumVigente(negocioId) {
      let negocio = get(/databases/$(database)/documents/negocios/$(negocioId)).data;
      return negocio.premiumUntil is timestamp && negocio.premiumUntil > request.time;
    }

    function terminosServicioPredeterminados() {
      return [
        'Respaldar datos antes de la intervencion.',
        'La garantia cubre solo los trabajos realizados.',
        'No hay responsabilidad por virus, mal uso o cambios de terceros.',
        'Todo trabajo requiere autorizacion del cliente.',
        'El tiempo de entrega depende de la complejidad del caso.',
        'El cliente debe revisar el equipo al momento de la entrega.',
        'No cubre golpes, liquidos, caidas o manipulacion indebida.',
        'Tras 30 dias de abandono no se garantiza resguardo del equipo.'
      ];
    }

    function configuracionServiciosFreeValida(negocioId) {
      let configPath = /databases/$(database)/documents/negocios/$(negocioId)/configuracion/servicios;
      let nueva = request.resource.data;
      let hoja = nueva.get('hojaServicio', {});
      return exists(configPath)
        ? (
            nueva.get('habilitarCanjes', true) == resource.data.get('habilitarCanjes', true) &&
            nueva.get('catalogoCanjes', []) == resource.data.get('catalogoCanjes', []) &&
            hoja.get('terminos', terminosServicioPredeterminados()) == resource.data.get('hojaServicio', {}).get('terminos', terminosServicioPredeterminados()) &&
            hoja.get('terminosPersonalizados', true) == resource.data.get('hojaServicio', {}).get('terminosPersonalizados', true)
          )
        : (
            nueva.get('habilitarCanjes', true) == true &&
            nueva.get('catalogoCanjes', []) == [] &&
            hoja.get('terminos', terminosServicioPredeterminados()) == terminosServicioPredeterminados()
          );
    }

    function escrituraFuncionesPremiumValida(negocioId, coleccion, documento) {
      return negocioTienePremiumVigente(negocioId) || (
        !(coleccion in ['fiados', 'promociones_descuentos']) &&
        !(coleccion == 'configuracion' && documento == 'descuento_manual') &&
        (coleccion != 'configuracion' || documento != 'servicios' ||
          (request.resource != null && configuracionServiciosFreeValida(negocioId))) &&
        (coleccion != 'clientes' || request.resource == null ||
          (resource == null
            ? request.resource.data.get('puntos', 0) == 0
            : request.resource.data.get('puntos', 0) == resource.data.get('puntos', 0))) &&
        // Servicios en plan gratuito: los abonos y las EVIDENCIAS quedan
        // congelados. "Congelados" y no "borrados" a proposito -- el negocio
        // que documento con Premium y luego dejo de pagar conserva sus fotos y
        // las sigue viendo; lo que no puede es agregar, reemplazar ni
        // eliminar. Exigir igualdad exacta cubre los tres casos de una vez.
        (coleccion != 'servicios' || request.resource == null ||
          (resource == null
            ? (request.resource.data.get('abonos', []) == [] &&
               request.resource.data.get('totalAbonado', 0) == 0 &&
               request.resource.data.get('ultimoAbonoEn', null) == null &&
               request.resource.data.get('evidencias', {}) == {})
            : (request.resource.data.get('abonos', []) == resource.data.get('abonos', []) &&
               request.resource.data.get('totalAbonado', 0) == resource.data.get('totalAbonado', 0) &&
               request.resource.data.get('ultimoAbonoEn', null) == resource.data.get('ultimoAbonoEn', null) &&
               request.resource.data.get('evidencias', {}) == resource.data.get('evidencias', {})))) &&
        (coleccion != 'ventas' || resource != null || request.resource == null || (
          request.resource.data.get('tipoPago', '') != 'fiado' &&
          request.resource.data.get('descuentoManual', 0) == 0 &&
          request.resource.data.get('descuentoRegla', 0) == 0 &&
          request.resource.data.get('descuentoPuntos', 0) == 0 &&
          request.resource.data.get('puntosCanjeados', 0) == 0 &&
          request.resource.data.get('promocionDescuentoAplicado', null) == null
        ))
      );
    }

    // -----------------------------------------------------------------------
    // Integridad de la aceptacion del cliente.
    //
    // Una aceptacion firmada solo puede nacer del flujo de firma, que corre en
    // una Cloud Function con el SDK de administracion -- y ese SDK no pasa por
    // estas reglas. Desde la aplicacion, en cambio, un usuario del negocio
    // PODRIA escribir a mano `aceptacion.estado = "aceptado"` y fabricar una
    // firma que nunca ocurrio. Esto lo impide.
    //
    // Lo que si puede hacer el negocio es crear la solicitud (estado
    // "pendiente"). Y si el servicio ya tiene una aceptacion registrada, puede
    // seguir editando el resto del servicio siempre que la deje INTACTA.
    //
    // `autorizaciones` (las versiones archivadas) solo puede crecer: nadie
    // borra en silencio una aceptacion o un rechazo anterior.
    // -----------------------------------------------------------------------
    function aceptacionIntegra() {
      let nueva = request.resource.data.get('aceptacion', {});
      let previa = resource == null ? {} : resource.data.get('aceptacion', {});
      let historialNuevo = request.resource.data.get('autorizaciones', []);
      let historialPrevio = resource == null ? [] : resource.data.get('autorizaciones', []);

      return (
        nueva.get('estado', '') in ['', 'pendiente'] ||
        nueva == previa
      ) && historialNuevo.size() >= historialPrevio.size();
    }

    function rastreoPublicoDisponible(negocioId) {
      let configPath = /databases/$(database)/documents/negocios/$(negocioId)/configuracion/servicios;
      return negocioTienePremiumVigente(negocioId) &&
        exists(configPath) &&
        get(configPath).data.get('trackingEnabled', false) == true;
    }

    function sameTenantValue(value) {
      return value is string && value == currentTenantId();
    }

    function sameTenantResource() {
      return isSuperAdmin() || (
        resource != null &&
        (
          sameTenantValue(resource.data.negocioId) ||
          sameTenantValue(resource.data.cuentaPrincipalUid)
        )
      );
    }

    function sameTenantRequest() {
      return isSuperAdmin() || (
        request.resource != null &&
        (
          sameTenantValue(request.resource.data.negocioId) ||
          sameTenantValue(request.resource.data.cuentaPrincipalUid)
        )
      );
    }

    function isTenantConfigDocument(documentId) {
      return documentId is string &&
        documentId.matches('^.+__' + currentTenantId() + '$');
    }

    function selfAutorizadoMutableFieldsOnly(documentId) {
      return request.resource != null &&
        request.auth.uid == documentId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activo',
          'online',
          'lastActive',
          'versionVista',
          'terminosAceptados',
          'terminosVersion',
          'terminosAceptadosAt',
          'setupCompleto',
          'promoPremium'
        ]);
    }

    function noSuperAdminWrite() {
      return request.resource == null || (
        request.resource.data.superAdmin != true &&
        request.resource.data.accesoAnalitica != true
      );
    }

    // El plan Gratuito limita el negocio a 3 usuarios; Premium es ilimitado.
    // Se apoya en el contador ya mantenido en negocios/{id}.conteos, no en un
    // conteo en vivo (Firestore Rules no permite agregaciones de colecciones).
    function dentroDelLimiteGratuito() {
      let negocioActual = get(/databases/$(database)/documents/negocios/$(currentTenantId())).data;
      return negocioActual.premium == true ||
        negocioActual.conteos.usuariosTotal < 3;
    }

    function tenantUserCreateAllowed() {
      return sameTenantRequest() &&
        noSuperAdminWrite() &&
        request.resource.data.negocioId == currentTenantId() &&
        request.resource.data.cuentaPrincipalUid == currentTenantId() &&
        dentroDelLimiteGratuito();
    }

    function tenantUserUpdateAllowed() {
      return isBusinessAdmin() &&
        sameTenantResource() &&
        sameTenantRequest() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'superAdmin',
          'accesoAnalitica',
          'negocioId',
          'cuentaPrincipalUid',
          'suscripcionControlada',
          'esCuentaPrincipal'
        ]);
    }

    function negocioOwnerUpdateAllowed(document) {
      return sameTenantValue(document) &&
        request.resource.data.cobrosAutomaticos != true &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'estado',
            'bloqueoRazon',
            'bloqueoFecha',
            'updatedByUid',
            'costosInternosVisibles',
            'premium',
            'planActual',
            'gratuito',
            'premiumProveedor',
            'premiumSubscriptionId',
            'premiumUltimoPagoId',
            'premiumUltimoPago',
            'premiumProximoPago',
            'premiumUntil',
            'renovacionAutomatica'
          ]) ||
          (
            resource.data.estado == 'pendiente' &&
            request.resource.data.estado == 'gratuito' &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'bloqueoRazon',
              'bloqueoFecha',
              'updatedByUid',
              'costosInternosVisibles',
              'premium',
              'planActual',
              'gratuito',
              'premiumProveedor',
              'premiumSubscriptionId',
              'premiumUltimoPagoId',
              'premiumUltimoPago',
              'premiumProximoPago',
              'premiumUntil',
              'renovacionAutomatica'
            ])
          )
        );
    }
    
    // Acceso a usuarios autorizados.
    match /autorizados/{document} {
      allow read: if isSignedIn() && (
        hasAnalyticsAccess() ||
        request.auth.uid == document ||
        sameTenantValue(resource.data.negocioId) ||
        sameTenantValue(resource.data.cuentaPrincipalUid)
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        tenantUserCreateAllowed() ||
        (
          request.auth.uid == document &&
          request.resource.data.negocioId == request.auth.uid &&
          request.resource.data.cuentaPrincipalUid == request.auth.uid &&
          request.resource.data.esCuentaPrincipal == true &&
          request.resource.data.rol == "Administrador" &&
          request.resource.data.superAdmin == false &&
          request.resource.data.accesoAnalitica == false &&
          request.resource.data.suscripcionControlada == false
        )
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        tenantUserUpdateAllowed() ||
        selfAutorizadoMutableFieldsOnly(document)
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (isBusinessAdmin() && sameTenantResource() && resource.data.superAdmin != true)
      );
    }

    // Recuperacion de membresia. Un usuario autenticado puede leer UNICAMENTE
    // su propia ficha de empleado (uid == request.auth.uid), aunque todavia no
    // exista su documento en `autorizados`. Sin esta lectura el sistema no
    // puede distinguir a un empleado sin perfil de un usuario nuevo, y termina
    // creandole un negocio duplicado.
    match /{path=**}/empleados/{document} {
      allow read: if isSignedIn() &&
        resource.data.uid is string &&
        resource.data.uid == request.auth.uid;
    }

    // Negocios registrados en CajaLibre.
    match /negocios/{document} {
      allow read: if isSignedIn() && (
        hasAnalyticsAccess() ||
        sameTenantValue(document) ||
        sameTenantValue(resource.data.negocioId) ||
        sameTenantValue(resource.data.cuentaPrincipalUid)
      );
      allow create: if isSignedIn() &&
        request.resource.data.get('premium', false) == false &&
        !request.resource.data.keys().hasAny([
          'premiumProveedor', 'premiumSubscriptionId', 'premiumUltimoPagoId',
          'premiumUltimoPago', 'premiumProximoPago', 'premiumUntil', 'renovacionAutomatica'
        ]) && (
        isSuperAdmin() ||
        (
          request.auth.uid == document &&
          request.resource.data.negocioId == request.auth.uid &&
          request.resource.data.cuentaPrincipalUid == request.auth.uid &&
          request.resource.data.estado in ['pendiente', 'gratuito'] &&
          request.resource.data.cobrosAutomaticos != true
        )
      );
      allow update: if isSignedIn() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'premium', 'premiumProveedor', 'premiumSubscriptionId',
          'premiumUltimoPagoId', 'premiumUltimoPago', 'premiumProximoPago',
          'premiumUntil', 'renovacionAutomatica'
        ]) && (
        isSuperAdmin() ||
        negocioOwnerUpdateAllowed(document)
      );
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    // Historial de pagos Premium: solo lectura para el dueno del negocio;
    // unicamente el Admin SDK (Cloud Functions) escribe aqui.
    match /negocios/{negocioId}/pagos_premium/{document} {
      allow read: if isSignedIn() && (isSuperAdmin() || negocioId == currentTenantId());
    }

    match /_legacy_terminos_aceptaciones/{document} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        sameTenantValue(resource.data.negocioId) ||
        request.auth.uid == resource.data.uid
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.auth.uid == request.resource.data.uid &&
          sameTenantValue(request.resource.data.negocioId) &&
          request.resource.data.aceptado == true
        )
      );
      allow update: if false;
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    match /negocios/{negocioId}/admin_bitacora/{document} {
      allow read: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          sameTenantValue(request.resource.data.negocioId) &&
          request.resource.data.tipo in [
            'terminos_aceptados',
            'configuracion_inicial_completa'
          ]
        )
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          sameTenantValue(resource.data.negocioId) &&
          sameTenantValue(request.resource.data.negocioId) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.tipo == resource.data.tipo &&
          request.resource.data.tipo in [
            'terminos_aceptados',
            'configuracion_inicial_completa'
          ]
        )
      );
      allow delete: if false;
    }

    // Telemetria sin contenido de formularios. Cada usuario escribe su actividad;
    // solo los superadministradores pueden consultar o eliminar el historial.
    match /negocios/{negocioId}/analitica_eventos/{document} {
      allow read: if hasAnalyticsAccess();
      allow delete: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() &&
        sameTenantValue(request.resource.data.negocioId) &&
        (
          request.resource.data.formato == 'resumen_diario_v1' ||
          (
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.tipo in [
              'vista_pagina',
              'tiempo_pagina',
              'click',
              'error',
              'rendimiento'
            ]
          )
        );
      allow update: if isSignedIn() &&
        sameTenantValue(resource.data.negocioId) &&
        sameTenantValue(request.resource.data.negocioId) &&
        (
          (
            resource.data.formato == 'resumen_diario_v1' &&
            request.resource.data.formato == 'resumen_diario_v1' &&
            request.resource.data.fecha == resource.data.fecha
          ) ||
          (
            resource.data.uid == request.auth.uid &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.tipo == resource.data.tipo
          )
        );
    }

    // Suscripciones del sistema. Solo el super admin edita; cada cuenta puede leer la suya.
    match /suscripciones/{document} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        sameTenantValue(document) ||
        sameTenantValue(resource.data.cuentaPrincipalUid)
      );
      allow write: if isSignedIn() && isSuperAdmin();
    }
    
    // Los servicios operativos son privados. El rastreador consulta una
    // proyeccion separada y limitada a campos aptos para el cliente.
    match /_legacy_servicios/{document} {
      allow read: if isSignedIn() && sameTenantResource();
      allow write: if isSignedIn() && sameTenantRequest();
    }

    // Una consulta collectionGroup solo evalua las reglas declaradas con el
    // comodin recursivo. La regla anclada a /negocios/{negocioId}/... de abajo
    // gobierna la escritura, pero no alcanza a la busqueda por folio, que
    // justamente no sabe a que negocio pertenece el servicio.
    match /{path=**}/servicios_publicos/{document} {
      allow read: if resource.data.trackingEnabled == true &&
        resource.data.negocioId is string &&
        rastreoPublicoDisponible(resource.data.negocioId);
    }

    match /negocios/{negocioId}/servicios_publicos/{document} {
      function proyeccionSegura() {
        return request.resource.data.keys().hasOnly([
          'negocioId', 'folio', 'tipoDispositivo', 'marca', 'modelo',
          'trabajo', 'status', 'fechaAprox', 'createdAt', 'updatedAt',
          'trackingEnabled'
        ]) &&
        request.resource.data.negocioId == negocioId &&
        request.resource.data.folio is string &&
        request.resource.data.trackingEnabled == true;
      }

      allow read: if resource.data.negocioId == negocioId &&
        resource.data.trackingEnabled == true &&
        rastreoPublicoDisponible(negocioId);
      allow create, update: if isSignedIn() &&
        negocioId == currentTenantId() &&
        (hasPermission('servicios.ver') || hasPermission('servicios.crear')) &&
        rastreoPublicoDisponible(negocioId) &&
        proyeccionSegura();
      allow delete: if false;
    }

    match /rastreo_publico_negocios/{negocioId} {
      function marcaPublicaSegura() {
        return request.resource.data.keys().hasOnly([
          'negocioId', 'nombre', 'logo', 'trackingEnabled', 'updatedAt'
        ]) &&
        request.resource.data.negocioId == negocioId &&
        request.resource.data.nombre is string &&
        request.resource.data.logo is string &&
        request.resource.data.trackingEnabled == true;
      }

      allow read: if resource.data.negocioId == negocioId &&
        resource.data.trackingEnabled == true &&
        rastreoPublicoDisponible(negocioId);
      allow create, update: if isSignedIn() &&
        negocioId == currentTenantId() &&
        (hasPermission('servicios.ver') || hasPermission('servicios.crear')) &&
        rastreoPublicoDisponible(negocioId) &&
        marcaPublicaSegura();
      allow delete: if false;
    }
    
    // Colecciones de negocio aisladas por cuenta principal.
    match /_legacy_clientes/{document} {
      allow read: if isSignedIn() && (hasAnalyticsAccess() || sameTenantResource());
      allow update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }
    
    match /_legacy_productos/{document} {
      allow read: if isSignedIn() && (hasAnalyticsAccess() || sameTenantResource());
      allow update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }

    match /_legacy_proveedores/{document} {
      allow read, update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }
    
    match /_legacy_ventas/{document} {
      allow read: if isSignedIn() && (hasAnalyticsAccess() || sameTenantResource());
      allow update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }

    match /_legacy_cotizaciones/{document} {
      allow read: if isSignedIn() && (hasAnalyticsAccess() || sameTenantResource());
      allow update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }

    match /_legacy_restaurante_ordenes/{document} {
      allow read: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
      allow update: if isSignedIn() && sameTenantResource() && sameTenantRequest() && (
        (
          resource.data.status == 'nueva' &&
          request.resource.data.status == 'preparando' &&
          request.resource.data.atendidaPorUid == request.auth.uid
        ) ||
        (
          resource.data.status == 'preparando' &&
          request.resource.data.status == 'lista' &&
          resource.data.atendidaPorUid == request.auth.uid &&
          request.resource.data.atendidaPorUid == request.auth.uid
        ) ||
        (
          resource.data.status == 'lista' &&
          request.resource.data.status == 'cobrada' &&
          authDocExists() &&
          authData().rol in [
            'Caja',
            'caja',
            'Cajero',
            'cajero',
            'Administrador',
            'administrador'
          ]
        ) ||
        (
          resource.data.status in ['nueva', 'preparando', 'lista'] &&
          request.resource.data.status == 'cancelada' &&
          hasPermission('restaurante.caja') &&
          request.resource.data.canceladaPorUid == request.auth.uid &&
          request.resource.data.cancelacionMotivo is string &&
          request.resource.data.cancelacionMotivo.size() >= 3
        ) ||
        (
          resource.data.tipoServicio == 'comer_aqui' &&
          resource.data.mesaAsignada == false &&
          request.resource.data.mesaAsignada == true &&
          authDocExists() &&
          authData().rol in ['Mesero', 'mesero', 'Administrador', 'administrador'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pisoId',
            'pisoNombre',
            'mesaNumero',
            'mesaKey',
            'mesaKeys',
            'mesaEtiqueta',
            'mesaAsignada',
            'mesaAsignadaPorUid',
            'mesaAsignadaPorNombre',
            'mesaAsignadaAt',
            'updatedAt'
          ])
        )
      );
      allow delete: if isSignedIn() && sameTenantResource() && isBusinessAdmin();
    }

    match /_legacy_restaurante_reservaciones/{document} {
      allow read: if isSignedIn() && sameTenantResource() && hasPermission('restaurante.mesero');
      allow create: if isSignedIn() && sameTenantRequest() && hasPermission('restaurante.mesero');
      allow update: if isSignedIn() && sameTenantResource() && sameTenantRequest() && hasPermission('restaurante.mesero');
      allow delete: if isSignedIn() && sameTenantResource() && isBusinessAdmin();
    }

    match /_legacy_restaurante_turnos/{document} {
      allow read: if isSignedIn() && sameTenantResource() && (
        resource.data.actorUid == request.auth.uid || isBusinessAdmin()
      );
      allow create: if isSignedIn() && sameTenantRequest() &&
        request.resource.data.actorUid == request.auth.uid;
      allow update: if isSignedIn() && sameTenantResource() && sameTenantRequest() && (
        resource.data.actorUid == request.auth.uid || isBusinessAdmin()
      );
      allow delete: if isSignedIn() && sameTenantResource() && isBusinessAdmin();
    }
    
    match /_legacy_cortes_caja/{document} {
      allow read, update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }
    
    // Indices globales del sistema.
    match /_legacy_folios/{document} {
      allow read, write: if isSignedIn();
    }
    
    match /_legacy_contadores_folio/{document} {
      allow read, write: if isSignedIn();
    }
    
    match /_legacy_egresos_diarios/{document} {
      allow read, update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }

    match /_legacy_empleados/{document} {
      allow read: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (isBusinessAdmin() && sameTenantRequest() && noSuperAdminWrite()) ||
        (
          request.auth.uid == request.resource.data.uid &&
          request.resource.data.negocioId == request.auth.uid &&
          request.resource.data.cuentaPrincipalUid == request.auth.uid &&
          noSuperAdminWrite()
        )
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          isBusinessAdmin() &&
          sameTenantResource() &&
          sameTenantRequest() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'superAdmin',
            'accesoAnalitica',
            'negocioId',
            'cuentaPrincipalUid',
            'suscripcionControlada',
            'esCuentaPrincipal'
          ])
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (isBusinessAdmin() && sameTenantResource() && resource.data.superAdmin != true)
      );
    }

    // Configuracion compartida por tenant.
    match /_legacy_configuracion/{document} {
      allow read: if isSignedIn() && (
        hasAnalyticsAccess() ||
        sameTenantResource() ||
        isTenantConfigDocument(document)
      );
      allow update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }

    // Sesiones por dispositivo para limitar equipos del titular.
    match /_legacy_sesiones_dispositivo/{document} {
      allow read: if isSignedIn() && (
        hasAnalyticsAccess() ||
        request.auth.uid == resource.data.uid ||
        sameTenantResource()
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.auth.uid == request.resource.data.uid &&
          sameTenantRequest()
        )
      );
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.auth.uid == resource.data.uid &&
          sameTenantRequest()
        )
      );
    }

    // Cola temporal del POS movil.
    match /_legacy_pos_mobile_scans/{document} {
      allow read, write: if isSignedIn();
    }

    // Encuesta voluntaria de recomendacion de CajaLibre.
    match /_legacy_recomendaciones/{document} {
      allow create: if isSignedIn()
        && sameTenantRequest()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.calificacion is int
        && request.resource.data.calificacion >= 0
        && request.resource.data.calificacion <= 10;
      allow read: if isSignedIn() && hasAnalyticsAccess();
    }

    // Videos públicos del Centro de ayuda; solo el superadministrador los gestiona.
    match /videos_soporte/{document} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isSuperAdmin();
    }

    // Avisos que CajaLibre envia a los negocios. Se guardan UNA vez y el campo
    // `audiencia` dice a quien le tocan. Solo la administracion global escribe.
    match /notificaciones_globales/{document} {
      // Un aviso dirigido en exclusiva a otro negocio tiene como audiencia
      // unicamente "negocio:<ese id>", asi que ninguna de las dos pruebas lo
      // alcanza y no hay forma de leerlo, ni con una consulta hecha a mano.
      function avisoParaEsteNegocio() {
        return resource.data.audiencia is list && (
          resource.data.audiencia.hasAny(['todos', 'plan:free', 'plan:premium']) ||
          resource.data.audiencia.hasAny(['negocio:' + currentTenantId()])
        );
      }

      allow read: if isSignedIn() && (isSuperAdmin() || avisoParaEsteNegocio());
      allow create, update, delete: if isSignedIn() && isSuperAdmin();
    }

    // Estado de lectura de los avisos. Un documento por persona, con el nombre
    // de su propia cuenta: nadie puede marcar por otro ni leer lo ajeno.
    match /negocios/{negocioId}/notificaciones_estado/{document} {
      allow read, write: if isSignedIn() && (
        isSuperAdmin() || (
          negocioId == currentTenantId() &&
          document == request.auth.uid
        )
      );
    }

    // Tickets de soporte. Un negocio solo alcanza los suyos; la administracion
    // global los ve todos.
    match /soporte_tickets/{ticketId} {
      function esTicketPropio() {
        return resource != null && resource.data.negocioId == currentTenantId();
      }

      allow read: if isSignedIn() && (isSuperAdmin() || esTicketPropio());
      allow create: if isSignedIn() &&
        request.resource.data.negocioId == currentTenantId() &&
        request.resource.data.usuarioUid == request.auth.uid &&
        request.resource.data.estado == 'abierto';
      // El negocio puede mover su propio ticket, pero nunca cambiarlo de dueño
      // ni asignarse un plan que no tiene.
      allow update: if isSignedIn() && (
        isSuperAdmin() || (
          esTicketPropio() &&
          request.resource.data.negocioId == resource.data.negocioId &&
          request.resource.data.premium == resource.data.premium
        )
      );
      allow delete: if isSignedIn() && isSuperAdmin();

      // Conversacion. Una nota interna (`interna: true`) solo la lee la
      // administracion: el cliente no puede verla aunque la pida a proposito.
      match /mensajes/{mensajeId} {
        function ticketDelNegocio() {
          return get(/databases/$(database)/documents/soporte_tickets/$(ticketId)).data.negocioId
            == currentTenantId();
        }

        allow read: if isSignedIn() && (
          isSuperAdmin() ||
          (resource.data.interna != true && ticketDelNegocio())
        );
        allow create: if isSignedIn() && (
          (isSuperAdmin() && request.resource.data.autor == 'soporte') ||
          (
            ticketDelNegocio() &&
            request.resource.data.autor == 'cliente' &&
            request.resource.data.interna == false &&
            request.resource.data.autorUid == request.auth.uid
          )
        );
        allow update, delete: if isSignedIn() && isSuperAdmin();
      }
    }

    // Ajustes propios de CajaLibre, como el costo de la asesoria por hora.
    // Cualquier negocio necesita leerlos para mostrarlos; solo la
    // administracion global los cambia.
    match /configuracion_cajalibre/{document} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isSuperAdmin();
    }

    // Sesiones por dispositivo. Cada persona administra UNICAMENTE las suyas:
    // el documento se llama con su uid (la sesion unica del plan Gratuito) o
    // con "uid__equipo" (una sesion por equipo en Premium). Sin esta
    // restriccion cualquier companero del mismo negocio podria expulsar a otro
    // o liberarse su propio limite escribiendo la sesion ajena.
    match /negocios/{negocioId}/sesiones_dispositivo/{document} {
      function esSesionPropia() {
        return isSignedIn() && (
          document == request.auth.uid ||
          document.matches('^' + request.auth.uid + '__.+$')
        );
      }

      function sesionBienFormada() {
        return request.resource.data.uid == request.auth.uid &&
          request.resource.data.negocioId == negocioId &&
          request.resource.data.cuentaPrincipalUid == negocioId &&
          request.resource.data.deviceId is string &&
          request.resource.data.deviceId != "";
      }

      // El administrador del negocio puede consultarlas para el conteo de
      // equipos del panel, pero nunca escribirlas.
      allow read: if isSignedIn() && (
        isSuperAdmin() || (
          negocioId == currentTenantId() &&
          (esSesionPropia() || isBusinessAdmin())
        )
      );
      allow create, update: if isSignedIn() &&
        negocioId == currentTenantId() &&
        esSesionPropia() &&
        sesionBienFormada();
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (negocioId == currentTenantId() && esSesionPropia())
      );
    }

    // Datos operativos privados, organizados dentro de cada negocio.
    match /negocios/{negocioId}/{subcollection}/{document} {
      allow read: if subcollection in [
        'clientes', 'fiados', 'productos', 'proveedores', 'ventas', 'cotizaciones',
        'cortes_caja', 'egresos_diarios', 'servicios', 'empleados',
        'configuracion', 'pos_mobile_scans',
        'terminos_aceptaciones', 'recomendaciones', 'restaurante_ordenes',
        'restaurante_reservaciones', 'restaurante_turnos', 'folios',
        'contadores_folio', 'promociones_descuentos'
      ] &&
      (subcollection != 'restaurante_reservaciones' || negocioTienePremiumVigente(negocioId)) && (
        (
          subcollection == 'configuracion' &&
          document in ['notificaciones', 'descuento_manual'] &&
          isSignedIn() &&
          (
            isSuperAdmin() ||
            (
              negocioId == currentTenantId() &&
              (document == 'notificaciones' || hasPermission('ventas.pos'))
            )
          )
        ) ||
        (
          subcollection == 'promociones_descuentos' &&
          isSignedIn() &&
          negocioId == currentTenantId() &&
          (hasPermission('ventas.pos') || hasPermission('productos.ver'))
        ) ||
        (isSignedIn() && (
          isSuperAdmin() ||
          (negocioId == currentTenantId() && canUseOperationalCollection(subcollection))
        ))
      );
      allow create, update, delete: if isSignedIn() &&
        escrituraFuncionesPremiumValida(negocioId, subcollection, document) &&
        (subcollection != 'servicios' || request.resource == null || aceptacionIntegra()) &&
        (
          isSuperAdmin() ||
          (negocioId == currentTenantId() && canUseOperationalCollection(subcollection))
        ) &&
        (
          subcollection != 'configuracion' ||
          document != 'descuento_manual' ||
          isSuperAdmin() ||
          isBusinessAdmin()
        ) &&
        (subcollection != 'restaurante_reservaciones' || negocioTienePremiumVigente(negocioId)) &&
        subcollection in [
          'clientes', 'fiados', 'productos', 'proveedores', 'ventas', 'cotizaciones',
          'cortes_caja', 'egresos_diarios', 'servicios', 'empleados',
          'configuracion', 'pos_mobile_scans',
          'terminos_aceptaciones', 'recomendaciones', 'restaurante_ordenes',
          'restaurante_reservaciones', 'restaurante_turnos', 'folios',
          'contadores_folio', 'promociones_descuentos'
        ];
    }
  }
}
