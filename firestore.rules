rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function autorizadoPath(uid) {
      return /databases/$(database)/documents/autorizados/$(uid);
    }

    function authDocExists() {
      return isSignedIn() && exists(autorizadoPath(request.auth.uid));
    }

    function authData() {
      return get(autorizadoPath(request.auth.uid)).data;
    }

    function currentTenantId() {
      return authDocExists()
        ? (
            authData().negocioId is string && authData().negocioId != ""
              ? authData().negocioId
              : (
                  authData().cuentaPrincipalUid is string &&
                  authData().cuentaPrincipalUid != ""
                    ? authData().cuentaPrincipalUid
                    : request.auth.uid
                )
          )
        : request.auth.uid;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'lechugapapayero@gmail.com';
    }

    function hasAnalyticsAccess() {
      return isSuperAdmin();
    }

    function isBusinessAdmin() {
      return authDocExists() && (
        authData().rol == "Administrador" ||
        authData().rol == "administrador"
      );
    }

    function hasPermission(key) {
      return isBusinessAdmin() || (
        authDocExists() &&
        authData().permisos is map &&
        authData().permisos[key] == true
      );
    }

    function canUseOperationalCollection(name) {
      return isBusinessAdmin() ||
        (name == 'productos' && (hasPermission('productos.ver') || hasPermission('ventas.pos'))) ||
        (name == 'clientes' && (hasPermission('clientes.ver') || hasPermission('ventas.pos'))) ||
        (name == 'fiados' && (hasPermission('clientes.ver') || hasPermission('ventas.pos'))) ||
        (name in ['ventas', 'cotizaciones', 'cortes_caja', 'egresos_diarios'] &&
          (hasPermission('ventas.pos') || hasPermission('reportes.ver'))) ||
        (name == 'promociones_descuentos' &&
          (hasPermission('promociones.gestionar') || hasPermission('descuentos.gestionar'))) ||
        (name == 'proveedores' &&
          (hasPermission('productos.ver') || hasPermission('configuracion.ver'))) ||
        (name == 'servicios' &&
          (hasPermission('servicios.ver') || hasPermission('servicios.crear'))) ||
        (name == 'empleados' && hasPermission('empleados.gestionar')) ||
        (name == 'configuracion' && hasPermission('configuracion.ver')) ||
        (name in ['restaurante_ordenes', 'restaurante_reservaciones', 'restaurante_turnos'] &&
          (hasPermission('restaurante.caja') ||
           hasPermission('restaurante.cocina') ||
           hasPermission('restaurante.mesero'))) ||
        name in [
          'sesiones_dispositivo', 'pos_mobile_scans', 'terminos_aceptaciones',
          'recomendaciones', 'folios', 'contadores_folio'
        ];
    }

    function sameTenantValue(value) {
      return value is string && value == currentTenantId();
    }

    function sameTenantResource() {
      return isSuperAdmin() || (
        resource != null &&
        (
          sameTenantValue(resource.data.negocioId) ||
          sameTenantValue(resource.data.cuentaPrincipalUid)
        )
      );
    }

    function sameTenantRequest() {
      return isSuperAdmin() || (
        request.resource != null &&
        (
          sameTenantValue(request.resource.data.negocioId) ||
          sameTenantValue(request.resource.data.cuentaPrincipalUid)
        )
      );
    }

    function isTenantConfigDocument(documentId) {
      return documentId is string &&
        documentId.matches('^.+__' + currentTenantId() + '$');
    }

    function selfAutorizadoMutableFieldsOnly(documentId) {
      return request.resource != null &&
        request.auth.uid == documentId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activo',
          'online',
          'lastActive',
          'versionVista',
          'terminosAceptados',
          'terminosVersion',
          'terminosAceptadosAt',
          'setupCompleto',
          'promoPremium'
        ]);
    }

    function noSuperAdminWrite() {
      return request.resource == null || (
        request.resource.data.superAdmin != true &&
        request.resource.data.accesoAnalitica != true
      );
    }

    // El plan Gratuito limita el negocio a 3 usuarios; Premium es ilimitado.
    // Se apoya en el contador ya mantenido en negocios/{id}.conteos, no en un
    // conteo en vivo (Firestore Rules no permite agregaciones de colecciones).
    function dentroDelLimiteGratuito() {
      let negocioActual = get(/databases/$(database)/documents/negocios/$(currentTenantId())).data;
      return negocioActual.premium == true ||
        negocioActual.conteos.usuariosTotal < 3;
    }

    function tenantUserCreateAllowed() {
      return sameTenantRequest() &&
        noSuperAdminWrite() &&
        request.resource.data.negocioId == currentTenantId() &&
        request.resource.data.cuentaPrincipalUid == currentTenantId() &&
        dentroDelLimiteGratuito();
    }

    function tenantUserUpdateAllowed() {
      return isBusinessAdmin() &&
        sameTenantResource() &&
        sameTenantRequest() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'superAdmin',
          'accesoAnalitica',
          'negocioId',
          'cuentaPrincipalUid',
          'suscripcionControlada',
          'esCuentaPrincipal'
        ]);
    }

    function negocioOwnerUpdateAllowed(document) {
      return sameTenantValue(document) &&
        request.resource.data.cobrosAutomaticos != true &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'estado',
            'bloqueoRazon',
            'bloqueoFecha',
            'updatedByUid',
            'costosInternosVisibles',
            'premium',
            'planActual',
            'gratuito',
            'premiumProveedor',
            'premiumSubscriptionId',
            'premiumUltimoPagoId',
            'premiumUltimoPago',
            'premiumProximoPago',
            'premiumUntil',
            'renovacionAutomatica'
          ]) ||
          (
            resource.data.estado == 'pendiente' &&
            request.resource.data.estado == 'gratuito' &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'bloqueoRazon',
              'bloqueoFecha',
              'updatedByUid',
              'costosInternosVisibles',
              'premium',
              'planActual',
              'gratuito',
              'premiumProveedor',
              'premiumSubscriptionId',
              'premiumUltimoPagoId',
              'premiumUltimoPago',
              'premiumProximoPago',
              'premiumUntil',
              'renovacionAutomatica'
            ])
          )
        );
    }
    
    // Acceso a usuarios autorizados.
    match /autorizados/{document} {
      allow read: if isSignedIn() && (
        hasAnalyticsAccess() ||
        request.auth.uid == document ||
        sameTenantValue(resource.data.negocioId) ||
        sameTenantValue(resource.data.cuentaPrincipalUid)
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        tenantUserCreateAllowed() ||
        (
          request.auth.uid == document &&
          request.resource.data.negocioId == request.auth.uid &&
          request.resource.data.cuentaPrincipalUid == request.auth.uid &&
          request.resource.data.esCuentaPrincipal == true &&
          request.resource.data.rol == "Administrador" &&
          request.resource.data.superAdmin == false &&
          request.resource.data.accesoAnalitica == false &&
          request.resource.data.suscripcionControlada == false
        )
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        tenantUserUpdateAllowed() ||
        selfAutorizadoMutableFieldsOnly(document)
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (isBusinessAdmin() && sameTenantResource() && resource.data.superAdmin != true)
      );
    }

    // Negocios registrados en CajaLibre.
    match /negocios/{document} {
      allow read: if isSignedIn() && (
        hasAnalyticsAccess() ||
        sameTenantValue(document) ||
        sameTenantValue(resource.data.negocioId) ||
        sameTenantValue(resource.data.cuentaPrincipalUid)
      );
      allow create: if isSignedIn() &&
        request.resource.data.get('premium', false) == false &&
        !request.resource.data.keys().hasAny([
          'premiumProveedor', 'premiumSubscriptionId', 'premiumUltimoPagoId',
          'premiumUltimoPago', 'premiumProximoPago', 'premiumUntil', 'renovacionAutomatica'
        ]) && (
        isSuperAdmin() ||
        (
          request.auth.uid == document &&
          request.resource.data.negocioId == request.auth.uid &&
          request.resource.data.cuentaPrincipalUid == request.auth.uid &&
          request.resource.data.estado in ['pendiente', 'gratuito'] &&
          request.resource.data.cobrosAutomaticos != true
        )
      );
      allow update: if isSignedIn() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'premium', 'premiumProveedor', 'premiumSubscriptionId',
          'premiumUltimoPagoId', 'premiumUltimoPago', 'premiumProximoPago',
          'premiumUntil', 'renovacionAutomatica'
        ]) && (
        isSuperAdmin() ||
        negocioOwnerUpdateAllowed(document)
      );
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    // Historial de pagos Premium: solo lectura para el dueno del negocio;
    // unicamente el Admin SDK (Cloud Functions) escribe aqui.
    match /negocios/{negocioId}/pagos_premium/{document} {
      allow read: if isSignedIn() && (isSuperAdmin() || negocioId == currentTenantId());
    }

    match /_legacy_terminos_aceptaciones/{document} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        sameTenantValue(resource.data.negocioId) ||
        request.auth.uid == resource.data.uid
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.auth.uid == request.resource.data.uid &&
          sameTenantValue(request.resource.data.negocioId) &&
          request.resource.data.aceptado == true
        )
      );
      allow update: if false;
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    match /negocios/{negocioId}/admin_bitacora/{document} {
      allow read: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          sameTenantValue(request.resource.data.negocioId) &&
          request.resource.data.tipo in [
            'terminos_aceptados',
            'configuracion_inicial_completa'
          ]
        )
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          sameTenantValue(resource.data.negocioId) &&
          sameTenantValue(request.resource.data.negocioId) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.tipo == resource.data.tipo &&
          request.resource.data.tipo in [
            'terminos_aceptados',
            'configuracion_inicial_completa'
          ]
        )
      );
      allow delete: if false;
    }

    // Telemetria sin contenido de formularios. Cada usuario escribe su actividad;
    // solo los superadministradores pueden consultar o eliminar el historial.
    match /negocios/{negocioId}/analitica_eventos/{document} {
      allow read: if hasAnalyticsAccess();
      allow delete: if isSignedIn() && isSuperAdmin();
      allow create: if isSignedIn() &&
        sameTenantValue(request.resource.data.negocioId) &&
        (
          request.resource.data.formato == 'resumen_diario_v1' ||
          (
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.tipo in [
              'vista_pagina',
              'tiempo_pagina',
              'click',
              'error',
              'rendimiento'
            ]
          )
        );
      allow update: if isSignedIn() &&
        sameTenantValue(resource.data.negocioId) &&
        sameTenantValue(request.resource.data.negocioId) &&
        (
          (
            resource.data.formato == 'resumen_diario_v1' &&
            request.resource.data.formato == 'resumen_diario_v1' &&
            request.resource.data.fecha == resource.data.fecha
          ) ||
          (
            resource.data.uid == request.auth.uid &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.tipo == resource.data.tipo
          )
        );
    }

    // Suscripciones del sistema. Solo el super admin edita; cada cuenta puede leer la suya.
    match /suscripciones/{document} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        sameTenantValue(document) ||
        sameTenantValue(resource.data.cuentaPrincipalUid)
      );
      allow write: if isSignedIn() && isSuperAdmin();
    }
    
    // Consulta publica de estatus. La regla recursiva tambien autoriza las
    // consultas collectionGroup usadas cuando el folio no incluye el negocio.
    match /{path=**}/servicios/{document} {
      allow read: if true;
    }

    // Estado publico de servicios legacy. Escritura aislada por tenant.
    match /_legacy_servicios/{document} {
      allow read: if true;
      allow write: if isSignedIn() && sameTenantRequest();
    }
    
    // Colecciones de negocio aisladas por cuenta principal.
    match /_legacy_clientes/{document} {
      allow read: if isSignedIn() && (hasAnalyticsAccess() || sameTenantResource());
      allow update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }
    
    match /_legacy_productos/{document} {
      allow read: if isSignedIn() && (hasAnalyticsAccess() || sameTenantResource());
      allow update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }

    match /_legacy_proveedores/{document} {
      allow read, update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }
    
    match /_legacy_ventas/{document} {
      allow read: if isSignedIn() && (hasAnalyticsAccess() || sameTenantResource());
      allow update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }

    match /_legacy_cotizaciones/{document} {
      allow read: if isSignedIn() && (hasAnalyticsAccess() || sameTenantResource());
      allow update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }

    match /_legacy_restaurante_ordenes/{document} {
      allow read: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
      allow update: if isSignedIn() && sameTenantResource() && sameTenantRequest() && (
        (
          resource.data.status == 'nueva' &&
          request.resource.data.status == 'preparando' &&
          request.resource.data.atendidaPorUid == request.auth.uid
        ) ||
        (
          resource.data.status == 'preparando' &&
          request.resource.data.status == 'lista' &&
          resource.data.atendidaPorUid == request.auth.uid &&
          request.resource.data.atendidaPorUid == request.auth.uid
        ) ||
        (
          resource.data.status == 'lista' &&
          request.resource.data.status == 'cobrada' &&
          authDocExists() &&
          authData().rol in [
            'Caja',
            'caja',
            'Cajero',
            'cajero',
            'Administrador',
            'administrador'
          ]
        ) ||
        (
          resource.data.status in ['nueva', 'preparando', 'lista'] &&
          request.resource.data.status == 'cancelada' &&
          hasPermission('restaurante.caja') &&
          request.resource.data.canceladaPorUid == request.auth.uid &&
          request.resource.data.cancelacionMotivo is string &&
          request.resource.data.cancelacionMotivo.size() >= 3
        ) ||
        (
          resource.data.tipoServicio == 'comer_aqui' &&
          resource.data.mesaAsignada == false &&
          request.resource.data.mesaAsignada == true &&
          authDocExists() &&
          authData().rol in ['Mesero', 'mesero', 'Administrador', 'administrador'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pisoId',
            'pisoNombre',
            'mesaNumero',
            'mesaKey',
            'mesaKeys',
            'mesaEtiqueta',
            'mesaAsignada',
            'mesaAsignadaPorUid',
            'mesaAsignadaPorNombre',
            'mesaAsignadaAt',
            'updatedAt'
          ])
        )
      );
      allow delete: if isSignedIn() && sameTenantResource() && isBusinessAdmin();
    }

    match /_legacy_restaurante_reservaciones/{document} {
      allow read: if isSignedIn() && sameTenantResource() && hasPermission('restaurante.mesero');
      allow create: if isSignedIn() && sameTenantRequest() && hasPermission('restaurante.mesero');
      allow update: if isSignedIn() && sameTenantResource() && sameTenantRequest() && hasPermission('restaurante.mesero');
      allow delete: if isSignedIn() && sameTenantResource() && isBusinessAdmin();
    }

    match /_legacy_restaurante_turnos/{document} {
      allow read: if isSignedIn() && sameTenantResource() && (
        resource.data.actorUid == request.auth.uid || isBusinessAdmin()
      );
      allow create: if isSignedIn() && sameTenantRequest() &&
        request.resource.data.actorUid == request.auth.uid;
      allow update: if isSignedIn() && sameTenantResource() && sameTenantRequest() && (
        resource.data.actorUid == request.auth.uid || isBusinessAdmin()
      );
      allow delete: if isSignedIn() && sameTenantResource() && isBusinessAdmin();
    }
    
    match /_legacy_cortes_caja/{document} {
      allow read, update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }
    
    // Indices globales del sistema.
    match /_legacy_folios/{document} {
      allow read, write: if isSignedIn();
    }
    
    match /_legacy_contadores_folio/{document} {
      allow read, write: if isSignedIn();
    }
    
    match /_legacy_egresos_diarios/{document} {
      allow read, update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }

    match /_legacy_empleados/{document} {
      allow read: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (isBusinessAdmin() && sameTenantRequest() && noSuperAdminWrite()) ||
        (
          request.auth.uid == request.resource.data.uid &&
          request.resource.data.negocioId == request.auth.uid &&
          request.resource.data.cuentaPrincipalUid == request.auth.uid &&
          noSuperAdminWrite()
        )
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          isBusinessAdmin() &&
          sameTenantResource() &&
          sameTenantRequest() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'superAdmin',
            'accesoAnalitica',
            'negocioId',
            'cuentaPrincipalUid',
            'suscripcionControlada',
            'esCuentaPrincipal'
          ])
        )
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (isBusinessAdmin() && sameTenantResource() && resource.data.superAdmin != true)
      );
    }

    // Configuracion compartida por tenant.
    match /_legacy_configuracion/{document} {
      allow read: if isSignedIn() && (
        hasAnalyticsAccess() ||
        sameTenantResource() ||
        isTenantConfigDocument(document)
      );
      allow update, delete: if isSignedIn() && sameTenantResource();
      allow create: if isSignedIn() && sameTenantRequest();
    }

    // Sesiones por dispositivo para limitar equipos del titular.
    match /_legacy_sesiones_dispositivo/{document} {
      allow read: if isSignedIn() && (
        hasAnalyticsAccess() ||
        request.auth.uid == resource.data.uid ||
        sameTenantResource()
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.auth.uid == request.resource.data.uid &&
          sameTenantRequest()
        )
      );
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.auth.uid == resource.data.uid &&
          sameTenantRequest()
        )
      );
    }

    // Cola temporal del POS movil.
    match /_legacy_pos_mobile_scans/{document} {
      allow read, write: if isSignedIn();
    }

    // Encuesta voluntaria de recomendacion de CajaLibre.
    match /_legacy_recomendaciones/{document} {
      allow create: if isSignedIn()
        && sameTenantRequest()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.calificacion is int
        && request.resource.data.calificacion >= 0
        && request.resource.data.calificacion <= 10;
      allow read: if isSignedIn() && hasAnalyticsAccess();
    }

    // Videos públicos del Centro de ayuda; solo el superadministrador los gestiona.
    match /videos_soporte/{document} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isSuperAdmin();
    }

    // Datos operativos privados, organizados dentro de cada negocio.
    match /negocios/{negocioId}/{subcollection}/{document} {
      allow read: if subcollection in [
        'clientes', 'fiados', 'productos', 'proveedores', 'ventas', 'cotizaciones',
        'cortes_caja', 'egresos_diarios', 'servicios', 'empleados',
        'configuracion', 'sesiones_dispositivo', 'pos_mobile_scans',
        'terminos_aceptaciones', 'recomendaciones', 'restaurante_ordenes',
        'restaurante_reservaciones', 'restaurante_turnos', 'folios',
        'contadores_folio', 'promociones_descuentos'
      ] && (
        subcollection == 'servicios' ||
        (
          subcollection == 'configuracion' &&
          document in ['notificaciones', 'descuento_manual'] &&
          isSignedIn() &&
          (
            isSuperAdmin() ||
            (
              negocioId == currentTenantId() &&
              (document == 'notificaciones' || hasPermission('ventas.pos'))
            )
          )
        ) ||
        (
          subcollection == 'promociones_descuentos' &&
          isSignedIn() &&
          negocioId == currentTenantId() &&
          hasPermission('ventas.pos')
        ) ||
        (isSignedIn() && (
          isSuperAdmin() ||
          (negocioId == currentTenantId() && canUseOperationalCollection(subcollection))
        ))
      );
      allow create, update, delete: if isSignedIn() &&
        (
          isSuperAdmin() ||
          (negocioId == currentTenantId() && canUseOperationalCollection(subcollection))
        ) &&
        (
          subcollection != 'configuracion' ||
          document != 'descuento_manual' ||
          isSuperAdmin() ||
          isBusinessAdmin()
        ) &&
        subcollection in [
          'clientes', 'fiados', 'productos', 'proveedores', 'ventas', 'cotizaciones',
          'cortes_caja', 'egresos_diarios', 'servicios', 'empleados',
          'configuracion', 'sesiones_dispositivo', 'pos_mobile_scans',
          'terminos_aceptaciones', 'recomendaciones', 'restaurante_ordenes',
          'restaurante_reservaciones', 'restaurante_turnos', 'folios',
          'contadores_folio', 'promociones_descuentos'
        ];
    }
  }
}
